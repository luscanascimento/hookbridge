# ==============================================================================
# HOOKBRIDGE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Ports
API_PORT=8080
WEB_PORT=80

# PostgreSQL Database Configuration
DB_NAME=hookbridge_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_PORT=5432

# RabbitMQ Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Redis Cache & Distributed State
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# JWT Authentication & Tokens
JWT_SECRET_KEY=generate_a_cryptographically_secure_key_at_least_32_bytes_long_here!
JWT_ISSUER=HookBridge
JWT_AUDIENCE=HookBridgeClients
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_DAYS=7

# EventFlow Integration (Data Plane)
EVENTFLOW_BASE_URL=http://eventflow-api:5000
EVENTFLOW_API_KEY=ef_live_secret_key_1234567890

# OpenTelemetry / Tracing Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=HookBridge.ControlPlane
